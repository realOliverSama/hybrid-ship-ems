# ==========================================================
# macOS
# ==========================================================

.DS_Store


# ==========================================================
# MATLAB / Simulink temporary and generated files
# ==========================================================

**/slprj/
**/sccprj/
**/*.slxc
**/*.asv
**/*.autosave

# Generated code/cache directories
**/codegen/


# ==========================================================
# STM32 / CMake build outputs
# ==========================================================

**/build/
**/build-*/
**/cmake-build-*/
**/Debug/
**/Release/

**/*.elf
**/*.map
**/*.list

# hex/bin 按语义目录区分（2026-08 修正，替代原全局 **/*.hex **/*.bin）：
# - flash/ 下为 CMake 生成的烧录产物 → 忽略
# - vendor SoftwarePackage 的 Binary/ 下为原厂随包提供的源资产
#   （fsbl.hex / network-data.hex / appli.hex，SRAM/Flash 部署工作流直接依赖）
#   → 允许 Git 管理，勿加全局规则
**/flash/*.hex
**/flash/*.bin


# ==========================================================
# Pi agent 运行时
# ==========================================================

.pi/safety-audit.log

# 质量门运行时裁决（每次运行重新生成；基线 config/gate_baseline_smoke.json 入库）
model/simulink/results/gate_result.json
firmware/gate/fw_gate_result.json

# ==========================================================
# Temporary files
# ==========================================================

*.tmp
*.temp
*.bak
*~


# ==========================================================
# Python helper scripts
# ==========================================================

__pycache__/
*.pyc
.venv/


# ==========================================================
# Local secrets
# ==========================================================

.env
.env.local

# ==========================================================
# Simulink 项目补充（2026-08，pi 代理）
