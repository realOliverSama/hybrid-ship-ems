# ==========================================================
# macOS
# ==========================================================

.DS_Store


# ==========================================================
# MATLAB / Simulink temporary and generated files
# ==========================================================

**/slprj/
**/sccprj/
**/*.slxc
**/*.asv
**/*.autosave

# Generated code/cache directories
**/codegen/


# ==========================================================
# STM32 / CMake build outputs
# ==========================================================

**/build/
**/build-*/
**/cmake-build-*/
**/Debug/
**/Release/

**/*.elf
**/*.map
**/*.list

# hex/bin 按语义目录区分（2026-08 修正，替代原全局 **/*.hex **/*.bin）：
# - flash/ 下为 CMake 生成的烧录产物 → 忽略
# - vendor SoftwarePackage 的 Binary/ 下为原厂随包提供的源资产
#   （fsbl.hex / network-data.hex / appli.hex，SRAM/Flash 部署工作流直接依赖）
#   → 允许 Git 管理，勿加全局规则
**/flash/*.hex
**/flash/*.bin


# ==========================================================
# Pi agent 运行时
# ==========================================================

.pi/safety-audit.log

# ==========================================================
# Temporary files
# ==========================================================

*.tmp
*.temp
*.bak
*~


# ==========================================================
# Python helper scripts
# ==========================================================

__pycache__/
*.pyc
.venv/


# ==========================================================
# Local secrets
# ==========================================================

.env
.env.local

# ==========================================================
# Simulink 项目补充（2026-08，pi 代理）
# ==========================================================

# Python 虚拟环境（任意命名：.venv / .venv_tf / .venv-stm32n6 ...）
**/.venv*/

# Simulink 内部缓存目录
**/_jitprj/
**/_sfprj/

# MEX 编译产物
**/*.mex*

# Simulink 版本兼容文件
**/*.slx.r*


# ==========================================================
# CMake/固件细节补充（2026-08，吸收自外部建议）
# ==========================================================

firmware/stm32n6/**/CMakeFiles/
firmware/stm32n6/**/CMakeCache.txt
firmware/stm32n6/**/cmake_install.cmake
firmware/stm32n6/**/build.ninja
firmware/stm32n6/**/.ninja_deps
firmware/stm32n6/**/.ninja_log
firmware/stm32n6/**/compile_commands.json

firmware/stm32n6/**/*.o
firmware/stm32n6/**/*.obj
firmware/stm32n6/**/*.d
firmware/stm32n6/**/*.su
firmware/stm32n6/**/*.cyclo

firmware/stm32n6/**/*.atk-backup
firmware/stm32n6/**/*.bak_*
