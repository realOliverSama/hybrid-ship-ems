{
  "schema": "dataset_v3_signal_registry_v1",
  "version": "1.0.0",
  "spec": "phase4-d-dataset-v3",
  "description": "Dataset v3 signal/role registry — 执行层唯一事实源（FR-465/DGN-02）。Builder/exporter/validator 一律消费本文件，禁止在脚本内维护独立 hard-coded feature-role list。Markdown 契约文档仅作解释层并引用本文件。",
  "source_conventions": {
    "logsout:<SignalName>": "Model E logsout 打点（scripts/+model/build_model_e.m configureLogging）",
    "scenario:<VARIABLE>": "场景级常量（base workspace 注入，逐航次已知；未打点信号的合法来源，Model E 零改动约束下不新增打点）",
    "fixture:<KIND>": "pilot causal fixture（DGN-13，全部行标 fixture_kind=PILOT_ONLY，禁入 formal）"
  },
  "enums": {
    "role": [
      "INPUT_H1",
      "INPUT_H2",
      "INPUT_K",
      "INPUT_F",
      "TARGET",
      "ORACLE",
      "METADATA",
      "FORBIDDEN"
    ],
    "temporal_domain": [
      "history",
      "future",
      "both",
      "none"
    ],
    "aggregation": [
      "time_mean",
      "interval_endpoint",
      "last_mode",
      "interval_any"
    ],
    "issue_time_semantics": [
      "none",
      "issue_snapshot"
    ],
    "predictor_access": [
      "default",
      "extended",
      "oracle_only",
      "forbidden",
      "metadata_only"
    ]
  },
  "role_predictor_access_binding": {
    "INPUT_H1": "default",
    "INPUT_H2": "extended",
    "INPUT_K": "default",
    "INPUT_F": "default",
    "TARGET": "forbidden",
    "ORACLE": "oracle_only",
    "METADATA": "metadata_only",
    "FORBIDDEN": "forbidden"
  },
  "aggregation_semantics": {
    "time_mean": "bin (a,b] 内 trapezoidal 时间加权均值（DGN-05 + design R1：统一 time-weighted 积分语义，非 mean(samples)）；功率列满足 Σ_k P̄_k·Δt ≈ ∫P dt（1e-9 相对）",
    "interval_endpoint": "bin 右端点值（状态积累量/约束快照）",
    "last_mode": "bin 内最后采样值（离散模式/状态）",
    "interval_any": "bin 内任一为真（事件/flag，仅 METADATA/ORACLE 列）"
  },
  "bin_semantics": "history bin H_j=(t0-j, t0-j+1], j=300..1；future bin F_k=(t0+(k-1)*10, t0+k*10], k=1..30；右闭",
  "ctrl_mode_zero_fill": "DGN-06：ctrl_mode=AUTO(0) 时 manual_power_cmd_pct 聚合列填 0.0；ctrl_mode=MANUAL(1) 时 v_ref_mps 聚合列填 0.0；ORACLE 层（*_unmasked）保留原始双通道真值",
  "target_derivation": "TARGET 条目（P_load_total_kW, future）的 y_k=E_k/10 由 native-rate trapezoidal 累计能量差分构建（DGN-08），与 time_mean 聚合路径同定义等价（交叉验证 <1e-9 相对）；禁从 1Hz 降采样流二次计算；E300=ΣE_k/3600 [kWh] 为 mandatory derived scalar",
